pkgname=(
  'handbrake-svt-av1-hdr-llvm-optimized'
  'handbrake-svt-av1-hdr-llvm-optimized-cli'
)

# Placeholder only; the real value is generated by pkgver() below.
pkgver=1.10.2
pkgrel=1
arch=('x86_64')
url="https://handbrake.fr/"
license=(GPL-2.0-only)
# Link against the split libgcc/libstdc++ runtime packages directly; the
# gcc-libs metapackage only pulls them in and namcap flags it as unneeded.
_commondeps=(
  'bzip2'
  'jansson'
  'lame'
  'libass'
  'libdrm'
  'libgcc'
  'libjpeg-turbo'
  'libogg'
  'libstdc++'
  'libtheora'
  'libva'
  'libvorbis'
  'libvpx'
  'libxml2'
  'numactl'
  'opus'
  'speex'
  'x264'
  'xz'
  'zlib'
)
_guideps=(
  'at-spi2-core'
  'cairo'
  'fontconfig'
  'freetype2'
  'gdk-pixbuf2'
  'glib2'
  'gst-plugins-base'
  'gst-plugins-base-libs'
  'gstreamer'
  'gtk4'
  'harfbuzz'
  'libgudev'
  'pango'
)
makedepends=(
  'base-devel'
  'intltool'
  'python'
  'nasm'
  'wget'
  'cmake'
  'meson'
  'git'
  'clang'
  'lld'
  'llvm'
  'rust'
  'cargo-c'
  'ffnvcodec-headers'
  # AMD VCE encoding on Linux requires Vulkan
  'vulkan-headers'
  "${_commondeps[@]}"
  "${_guideps[@]}"
)
options=('!lto' '!debug') # https://bugs.archlinux.org/task/72600
source=("HandBrake::git+https://github.com/HandBrake/HandBrake.git" "HandBrake-SVT-AV1-HDR::git+https://github.com/Uranite/HandBrake-SVT-AV1-HDR.git")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  local hb hdr
  cd "${srcdir}/HandBrake"
  hb=$(git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
  cd "${srcdir}/HandBrake-SVT-AV1-HDR"
  hdr=$(git rev-parse --short=7 HEAD)
  printf '%s.hdr.%s\n' "$hb" "$hdr"
}

setup_compiler() {
  export CC="/usr/bin/clang"
  export CXX="/usr/bin/clang++"
  export CPP="/usr/bin/clang-cpp"
  unset CFLAGS CXXFLAGS
  # HandBrake adds -O3 itself and --harden already provides SSP + FORTIFY.
  # Add only the distribution hardening flags it does not set. No -O flag:
  # CFLAGS are appended after HandBrake's -O3 on the compile line, so -O2
  # here would silently downgrade the build.
  export CFLAGS="-fno-plt -fstack-clash-protection -fcf-protection"
  export CXXFLAGS="$CFLAGS"
  export LD="/usr/bin/lld"
  # Preserve makepkg's hardening/linker flags (RELRO, BIND_NOW, --as-needed)
  # and only add the LLVM linker.
  export LDFLAGS="${LDFLAGS:--Wl,--as-needed -Wl,-z,relro,-z,now} -fuse-ld=lld"
  export AR="/usr/bin/llvm-ar"
  export RANLIB="/usr/bin/llvm-ranlib"
  export NM="/usr/bin/llvm-nm"
  export ADDR2LINE="/usr/bin/llvm-addr2line"
  export OBJCOPY="/usr/bin/llvm-objcopy"
  export OBJDUMP="/usr/bin/llvm-objdump"
  export READELF="/usr/bin/llvm-readelf"
  export STRIP="/usr/bin/llvm-strip"
}

build() {
  ./HandBrake-SVT-AV1-HDR/patch.sh
  setup_compiler

  local -a CONFIGURE_OPTIONS=(
    --launch-jobs=0
    --prefix=/usr
    --cc="${CC}"
    --ar="${AR}"
    --ranlib="${RANLIB}"
    --strip="${STRIP}"
    --lto=on
    --enable-qsv
    --enable-vce
    --enable-nvdec
    --enable-libdovi
  )

  cd "${srcdir}/HandBrake" || return 1
  ./configure "${CONFIGURE_OPTIONS[@]}"
  make -C build
}

package_handbrake-svt-av1-hdr-llvm-optimized() {
  pkgdesc="Multithreaded video transcoder optimized with LLVM"
  depends=(
    'hicolor-icon-theme'
    "${_commondeps[@]}"
    "${_guideps[@]}"
  )
  optdepends=(
    'gst-plugins-good: for video previews'
    'gst-libav: for video previews'
    'gvfs: for CD/DVD drive access'
    'intel-media-sdk: Intel QuickSync support'
    'nvidia-utils: NVIDIA NVENC support'
    'libdvdcss: for decoding encrypted DVDs'
    'vulkan-icd-loader: AMD VCE encoding support'
    'vulkan-radeon: AMD VCE encoding support (AMD GPU driver)'
  )
  provides=("handbrake=${pkgver}")
  conflicts=(handbrake)

  make \
    --directory="${srcdir}/HandBrake/build" \
    DESTDIR="${pkgdir}" \
    install
  rm -f "${pkgdir}/usr/bin/HandBrakeCLI"
}

package_handbrake-svt-av1-hdr-llvm-optimized-cli() {
  pkgdesc="Multithreaded video transcoder optimized with LLVM (CLI)"
  depends=("${_commondeps[@]}")
  optdepends=(
    'intel-media-sdk: Intel QuickSync support'
    'nvidia-utils: NVIDIA NVENC support'
    'libdvdcss: for decoding encrypted DVDs'
    'vulkan-icd-loader: AMD VCE encoding support'
    'vulkan-radeon: AMD VCE encoding support (AMD GPU driver)'
  )
  provides=("handbrake-cli=${pkgver}")
  conflicts=(handbrake-cli)

  install -D "${srcdir}/HandBrake/build/HandBrakeCLI" "${pkgdir}/usr/bin/HandBrakeCLI"
}
